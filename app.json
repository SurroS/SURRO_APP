{
  "expo": {
    "name": "Surro",
    "slug": "surro",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon1.png",
    "splash": {
      "image": "./assets/images/adaptive-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0E0E55"
    },
    "scheme": "surro",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.surrosantara.mobile",
      "usesAppleSignIn": true,
      "associatedDomains": [
        "applinks:surro.app"
      ],
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSExceptionDomains": {
            "localhost": {
              "NSIncludesSubdomains": true
            },
            "10.0.2.2": {
              "NSIncludesSubdomains": true
            }
          }
        },
        "NSFaceIDUsageDescription": "Sign in with Apple requires FaceID to confirm your identity."
      }
    },
    "android": {
      "package": "com.surrosantara.mobile",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.RECORD_AUDIO",
        "android.permission.INTERNET",
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
        [
          "expo-build-properties",
          {
            "ios": {
              "newArchEnabled": true
            },
            "android": {
              "newArchEnabled": true,
              "enableProguardInReleaseBuilds": true
            }
          }
        ],
      "expo-router",
      "expo-font",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.321354387399-u4qsn500nvnj8738hnr3imnpp7rkg7t4"
        }
      ],
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Surro to use Face ID."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Surro to access your photos",
          "cameraPermission": "Allow Surro to access your camera"
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Allow Surro to access your contacts."
        }
      ],
      [
        "expo-document-picker",
        {
          "iCloudContainerEnvironment": "Production"
        }
      ],
      [
        "expo-notifications",
        {
          "androidMode": "production",
          "androidCollapsedTitle": "Surro"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "14e7d0ff-8bf2-46de-88f0-fd3bf12debda"
      },
      "router": {}
    }
  }
}
