{
  "expo": {
    "name": "Surro",
    "slug": "surro",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#374DA0"
    },
    "scheme": "surro",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.surrosantara.mobileapp",
      "usesAppleSignIn": true,
      "associatedDomains": [
        "applinks:surro.app"
      ],
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true,
          "NSExceptionDomains": {
            "localhost": {
              "NSIncludesSubdomains": true
            },
            "10.0.2.2": {
              "NSIncludesSubdomains": true
            }
          }
        },
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "321354387399-seshh2oha2amisist1b9nu7k7h2806cj.apps.googleusercontent.com",
              "surro"
            ]
          }
        ],
        "NSFaceIDUsageDescription": "Sign in with Apple requires FaceID to confirm your identity."
      },
      "config": {
        "googleSignIn": {
          "reservedClientId": "321354387399-trkjkc1s00kpls3mvib35l5ieke5mig3.apps.googleusercontent.com"
        }
      }
    },
    "android": {
      "package": "com.surrosantara.mobileapp",
       "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-build-properties",
        {
          "ios": {
            "newArchEnabled": true
          },
          "android": {
            "newArchEnabled": true
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Surro to use Face ID."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Surro to access your photos",
          "cameraPermission": "Allow Surro to access your camera"
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Allow Surro to access your contacts."
        }
      ],
      [
        "expo-document-picker",
        {
          "iCloudContainerEnvironment": "Production"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "50b5b0d5-9fbd-46ea-8769-ca33f946ef88"
      }
    }
  }
}
