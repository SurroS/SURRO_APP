{
  "expo": {
    "name": "Surro",
    "slug": "surro",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon1.png",
    "splash": {
      "image": "./assets/images/adaptive-icon.png",
      "resizeMode": 200,
      "backgroundColor": "#0E0E55"
    },
    "scheme": "surro",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.surrosantara.mobile",
      "usesAppleSignIn": true,
      "associatedDomains": [
        "applinks:surro.app"
      ],
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true,
          "NSExceptionDomains": {
            "localhost": {
              "NSIncludesSubdomains": true
            },
            "10.0.2.2": {
              "NSIncludesSubdomains": true
            }
          }
        },
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "321354387399-u4qsn500nvnj8738hnr3imnpp7rkg7t4.apps.googleusercontent.com"
            ]
          }
        ],
        "NSFaceIDUsageDescription": "Sign in with Apple requires FaceID to confirm your identity."
      }
    },
    "android": {
      "package": "com.surrosantara.mobile",
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.RECORD_AUDIO"
      ],
      "config": {
        "googleSignIn": {
          "reservedClientId": "321354387399-t6ahu1dmgjm7gcfi1p90leteos4bpqp8.apps.googleusercontent.com"
        }
      }
    },
    "extra": {
      "eas": {
        "projectId": "50b5b0d5-9fbd-46ea-8769-ca33f946ef88"
      }
    }
  },
  "plugins": [
    "expo-router",
    "expo-font",
    [
      "expo-build-properties",
      {
        "ios": {
          "newArchEnabled": true
        },
        "android": {
          "newArchEnabled": true
        }
      }
    ],
    "expo-secure-store",
    [
      "expo-local-authentication",
      {
        "faceIDPermission": "Allow Surro to use Face ID."
      }
    ],
    [
      "expo-image-picker",
      {
        "photosPermission": "Allow Surro to access your photos",
        "cameraPermission": "Allow Surro to access your camera"
      }
    ],
    [
      "expo-contacts",
      {
        "contactsPermission": "Allow Surro to access your contacts."
      }
    ],
    [
      "expo-document-picker",
      {
        "iCloudContainerEnvironment": "Production"
      }
    ]
  ],
  "extra": {
    "eas": {
      "projectId": "50b5b0d5-9fbd-46ea-8769-ca33f946ef88"
    }
  }
}
